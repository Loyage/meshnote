# Copy to .env. Leave the key blank to use the local Mock demo.
# Never prefix these values with VITE_: API keys must remain server-only.
MESHNOTE_LLM_API_KEY=
MESHNOTE_LLM_BASE_URL=https://api.openai.com/v1
MESHNOTE_LLM_MODEL=gpt-4o-mini
MESHNOTE_LLM_TIMEOUT_MS=120000
# Keep 8787 for bun run dev: vite.config.ts forwards /api to this port.
MESHNOTE_PORT=8787
